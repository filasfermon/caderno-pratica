{
  "name": "caderno-pratica",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Caderno Prática: app de revisão e reforço do Caderno de Alfabetização (PWA, funciona sem internet).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:firebase": "npx -y firebase-tools@15 emulators:exec --only auth,firestore --project demo-caderno \"npx playwright test -c playwright.firebase.config.ts\"",
    "pronuncia": "tsx scripts/gerar-pronuncia.ts",
    "icones": "tsx scripts/gerar-icones.ts",
    "relatorio": "tsx scripts/relatorio-conteudo.ts"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "firebase": "^12.19.0"
  }
}
