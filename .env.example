# Copie este arquivo para ".env" (no computador) ou cadastre as mesmas variáveis
# na Cloudflare Pages (Settings → Variables and secrets). Veja CONFIGURAR_FIREBASE_E_CLOUDFLARE.md.
# Sem estas variáveis, o app funciona normalmente, só com "ENTRAR SEM CONTA".

# Dados do app web do Firebase (Console do Firebase → Configurações do projeto → Seus apps)
VITE_FIREBASE_API_KEY=
# Use o domínio do próprio app (ex.: caderno-pratica.pages.dev). A Pages Function em
# functions/__/auth repassa o login para SEU-PROJETO.firebaseapp.com.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Só na Cloudflare (usado pela Pages Function do login): SEU-PROJETO.firebaseapp.com
FIREBASE_AUTH_HOST=

# Caminho do site. Deixe vazio na Cloudflare (o padrão é "/").
# O GitHub Pages usa "/NOME-DO-REPOSITORIO/" (o workflow preenche sozinho).
BASE_PATH=
